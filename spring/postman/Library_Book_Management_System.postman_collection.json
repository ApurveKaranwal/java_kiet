      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/books/search?keyword=Algorithms",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "books",
            "search"
          ],
          "query": [
            {
              "key": "keyword",
              "value": "Algorithms"
            }
          ]
        },
        "description": "Free-text search querying across title, author, and ISBN fields."
